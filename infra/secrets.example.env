# =============================================================================
# Project AXIOM -- axiom-core environment TEMPLATE (secrets.example.env)
# =============================================================================
# This file is COMMITTED to Git and must NEVER contain a real secret.
#
# How to use it:
#   1. Do not copy it by hand. Run (from the repo root, plain PowerShell 5.1):
#
#        powershell -ExecutionPolicy Bypass -File infra\scripts\new-env.ps1
#
#      The script copies this template to infra\.env ONLY IF it does not
#      already exist, then replaces every generate-me placeholder token below
#      with a cryptographically random value (System.Security.Cryptography
#      RNG). After a successful run no placeholder survives -- verify with:
#
#        Select-String -Path infra\.env -Pattern '__GEN[E]RATE_'
#
#      (expect no output; the [E] stops the hint from matching itself)
#   2. Real values live ONLY in infra\.env, which is gitignored. Verify:
#
#        git check-ignore -v infra/.env      # must print a .gitignore match
#
#   3. docker compose reads infra\.env twice: for ${VAR} interpolation in
#      docker-compose.yml (MYSQL_* bootstrap) and as env_file for the fleet
#      container (all FLEET_* vars).
#
# Manual generation (reference, if you ever fill a value without the script):
#   passwords:  openssl rand -base64 24
#   FLEET_SERVER_PRIVATE_KEY:  openssl rand -base64 32   (>= 32 bytes, base64)
#
# =============================================================================
# !! WARNING -- FLEET_SERVER_PRIVATE_KEY IS PERMANENT !!
#
#   This key encrypts Fleet's MDM assets (APNs cert/key, SCEP identities,
#   enrollment tokens) at rest in MySQL. It is what ENABLES MDM at all.
#   Once any MDM asset exists, REGENERATING OR LOSING THIS KEY MAKES THOSE
#   ASSETS PERMANENTLY UNDECRYPTABLE -- there is no recovery path.
#
#     * generate it exactly once (new-env.ps1 does this);
#     * back it up out-of-band (password manager) together with a note that
#       it pairs with the mysql-data volume -- each is useless alone;
#     * never re-run generation over an existing infra\.env (the script
#       refuses to overwrite for exactly this reason).
# =============================================================================


# ---------------------------------------------------------------------------
# MySQL bootstrap (consumed by the mysql container on FIRST boot of a fresh
# mysql-data volume; changing them later does NOT alter an existing database)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=__GENERATE_MYSQL_ROOT_PASSWORD__
MYSQL_DATABASE=fleet
MYSQL_USER=fleet
MYSQL_PASSWORD=__GENERATE_MYSQL_FLEET_PASSWORD__

# ---------------------------------------------------------------------------
# Fleet -> MySQL (must mirror the MYSQL_* values above; new-env.ps1 keeps the
# two password fields identical by replacing the same token in both places)
# ---------------------------------------------------------------------------
FLEET_MYSQL_ADDRESS=mysql:3306
FLEET_MYSQL_DATABASE=fleet
FLEET_MYSQL_USERNAME=fleet
FLEET_MYSQL_PASSWORD=__GENERATE_MYSQL_FLEET_PASSWORD__

# ---------------------------------------------------------------------------
# Fleet -> Redis
# ---------------------------------------------------------------------------
FLEET_REDIS_ADDRESS=redis:6379

# ---------------------------------------------------------------------------
# Fleet server listener + proxy contract
# ---------------------------------------------------------------------------
# Plain-HTTP listener inside the compose bridge (default would be 8080; the
# lab standardizes on 1337). TLS is OFF here because Caddy owns TLS at :443.
FLEET_SERVER_ADDRESS=0.0.0.0:1337
FLEET_SERVER_TLS=false

# The EXTERNAL name clients use (browser, fleetctl, fleetd, MDM enroll URLs).
# Must line up with the hosts entry and the mkcert leaf SANs.
FLEET_SERVER_URL=https://fleet.axiom.lab

# Encrypts MDM assets at rest -- see the permanence warning in the header.
# NOT a TLS key, NOT the enroll secret. >= 32 random bytes, base64.
FLEET_SERVER_PRIVATE_KEY=__GENERATE_FLEET_SERVER_PRIVATE_KEY__

# Live-query results ride a WebSocket through the Caddy proxy; the browser's
# Origin no longer matches Fleet's own URL, so this must be true or the
# live-query UI silently never streams results.
FLEET_SERVER_WEBSOCKETS_ALLOW_UNSAFE_ORIGIN=true

# Caddy is a SIBLING CONTAINER, so Fleet sees its bridge IP (not loopback).
# This must cover the compose network's subnet or Fleet ignores
# X-Forwarded-For and logs Caddy's IP for every agent. The subnet is pinned
# in docker-compose.yml (networks: -> ipam); confirm what is actually live:
#   docker network inspect axiom-core_default
FLEET_SERVER_TRUSTED_PROXIES=172.28.0.0/16

# ---------------------------------------------------------------------------
# osquery log destinations (filesystem plugin -> the fleet-logs named volume;
# the Phase 5 telemetry pipeline tails these)
# ---------------------------------------------------------------------------
FLEET_OSQUERY_STATUS_LOG_PLUGIN=filesystem
FLEET_OSQUERY_RESULT_LOG_PLUGIN=filesystem
FLEET_FILESYSTEM_STATUS_LOG_FILE=/logs/osqueryd.status.log
FLEET_FILESYSTEM_RESULT_LOG_FILE=/logs/osqueryd.results.log

# ---------------------------------------------------------------------------
# Policy cadence -- how often hosts re-evaluate compliance policies. Default is
# 1h; the lab uses 1m so break/fix policy demos flip red<->green quickly (Host
# Details "Refetch" also forces an immediate run). Raise this for a large fleet.
# ---------------------------------------------------------------------------
FLEET_OSQUERY_POLICY_UPDATE_INTERVAL=1m

# ---------------------------------------------------------------------------
# Prometheus /metrics (Phase 5 telemetry). Fleet does NOT serve /metrics by
# default -- the path falls through to the web app. Setting a basic-auth
# username+password ENABLES the endpoint (protected by those creds); the
# telemetry Prometheus scrapes it with the same creds. Alternative:
# FLEET_PROMETHEUS_BASIC_AUTH_DISABLE=true serves it unauthenticated (do not
# use on a LAN-exposed server). See infra/telemetry/.
# ---------------------------------------------------------------------------
FLEET_PROMETHEUS_BASIC_AUTH_USERNAME=axiom-prometheus
FLEET_PROMETHEUS_BASIC_AUTH_PASSWORD=__GENERATE_FLEET_PROMETHEUS_PASSWORD__

# ---------------------------------------------------------------------------
# Phase 5 telemetry (consumed by infra/telemetry/docker-compose.yml, which
# reads THIS same .env). Grafana admin login + the dedicated Fleet observer
# (api-only) user the fleet-exporter authenticates as. Create the user once:
#   fleetctl user create --name "AXIOM Exporter" --email exporter@axiom.lab \
#       --password <FLEET_EXPORTER_PASSWORD> --api-only --global-role observer
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=__GENERATE_GRAFANA_ADMIN_PASSWORD__
FLEET_EXPORTER_EMAIL=exporter@axiom.lab
FLEET_EXPORTER_PASSWORD=__GENERATE_FLEET_EXPORTER_PASSWORD__
# api-only users authenticate by TOKEN, not /login. `fleetctl user create ...
# --api-only` prints the token once -- paste it into infra/.env here.
FLEET_EXPORTER_TOKEN=__PASTE_API_ONLY_USER_TOKEN__

# ---------------------------------------------------------------------------
# Vulnerability processing (CVE feed cache lives on the fleet-vulndb volume)
# ---------------------------------------------------------------------------
FLEET_VULNERABILITIES_DATABASES_PATH=/vulndb

# ---------------------------------------------------------------------------
# Windows MDM -- WSTEP identity CA that signs Windows MDM client identity certs
# (unrelated to the mkcert TLS CA). Generate it with:
#     powershell -ExecutionPolicy Bypass -File infra\scripts\new-wstep-ca.ps1
# which writes infra/mdm/fleet-mdm-win-wstep.{crt,key} (gitignored), bind-mounted
# read-only at /etc/fleet/mdm. The path (non-_BYTES) form avoids multi-line PEM in
# this file. Required to turn Windows MDM ON -- FLEET_SERVER_PRIVATE_KEY alone is
# not enough. After setting these, `docker compose up -d` to recreate fleet, then
# enable: PATCH /api/latest/fleet/config {"mdm":{"windows_enabled_and_configured":true}}
# ---------------------------------------------------------------------------
FLEET_MDM_WINDOWS_WSTEP_IDENTITY_CERT=/etc/fleet/mdm/fleet-mdm-win-wstep.crt
FLEET_MDM_WINDOWS_WSTEP_IDENTITY_KEY=/etc/fleet/mdm/fleet-mdm-win-wstep.key

# ---------------------------------------------------------------------------
# License -- empty on purpose: the lab runs Fleet FREE. Free and Premium are
# the same binary; a key would only toggle Premium features on.
# ---------------------------------------------------------------------------
FLEET_LICENSE_KEY=
