{
  "uid": "axiom-fleet-health",
  "title": "AXIOM · Fleet Health",
  "tags": ["axiom", "fleet"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Agents reporting (heartbeat, last 5m)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "axiom-loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "axiom-loki" },
          "expr": "count(sum by (host) (count_over_time({job=\"fleet_osquery\", query=\"axiom-heartbeat\"} [5m])))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fleet server",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "axiom-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "axiom-prometheus" },
          "expr": "up{job=\"fleet\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fleet goroutines",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "axiom-prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "axiom-prometheus" }, "expr": "go_goroutines{job=\"fleet\"}", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 2000 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fleet RSS memory",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "axiom-prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "axiom-prometheus" }, "expr": "process_resident_memory_bytes{job=\"fleet\"}", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Heartbeats / min by host (Loki)",
      "description": "Each online host emits system_info every 60s. When an agent is killed, its line drops to zero within one interval -- the fleet-health acceptance signal.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "loki", "uid": "axiom-loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "axiom-loki" },
          "expr": "sum by (host) (count_over_time({job=\"fleet_osquery\", query=\"axiom-heartbeat\"} [1m]))",
          "queryType": "range",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15, "showPoints": "auto", "lineWidth": 2, "spanNulls": false } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Fleet HTTP request rate (Prometheus)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "axiom-prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "axiom-prometheus" }, "expr": "sum(rate(http_request_duration_seconds_count{job=\"fleet\"}[5m]))", "legendFormat": "req/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Recent host telemetry (Loki)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "loki", "uid": "axiom-loki" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "axiom-loki" }, "expr": "{job=\"fleet_osquery\"}", "queryType": "range" }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "dedupStrategy": "none" }
    }
  ]
}
